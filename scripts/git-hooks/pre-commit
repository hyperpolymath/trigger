#!/usr/bin/env bash
#
# pre-commit hook for Trigger
#
# Runs automated checks before allowing a commit.
#
# SPDX-License-Identifier: MPL-2.0

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Source hook configuration
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"
CONFIG_FILE="$HOOK_DIR/config.sh"

# Load configuration if exists
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    # Defaults
    ENABLE_PRE_COMMIT=${ENABLE_PRE_COMMIT:-1}
    STRICTNESS_LEVEL=${STRICTNESS_LEVEL:-2}
    CHECK_TIMEOUT=${CHECK_TIMEOUT:-300}
    CHECK_DIRS=${CHECK_DIRS:-"src ffi tests"}
    SPDX_CHECK_EXTENSIONS=${SPDX_CHECK_EXTENSIONS:-"ads adb zig idr"}
fi

# Check if pre-commit is enabled
if [ "$ENABLE_PRE_COMMIT" -ne 1 ]; then
    echo -e "${BLUE}[pre-commit]${NC} Hook disabled in config. Skipping checks."
    exit 0
fi

# Function to print header
print_header() {
    echo -e "\n${BLUE}========================================${NC}"
    echo -e "${BLUE}  Trigger pre-commit Hook${NC}"
    echo -e "${BLUE}========================================${NC}\n"
}

# Function to print section
print_section() {
    echo -e "${YELLOW}--- $1 ---${NC}"
}

# Function to print success
print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Function to print failure
print_failure() {
    echo -e "${RED}✗${NC} $1"
}

# Function to print warning
print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to run a check with timeout
run_check() {
    local name="$1"
    local cmd="$2"
    local timeout="${3:-$CHECK_TIMEOUT}"
    
    print_section "$name"
    
    if ! timeout "$timeout" bash -c "$cmd" 2>&1; then
        print_failure "$name failed"
        if [ "$STRICTNESS_LEVEL" -ge 2 ]; then
            exit 1
        else
            print_warning "Continuing despite failure (strictness level: $STRICTNESS_LEVEL)"
        fi
    else
        print_success "$name passed"
    fi
}

# Main execution
main() {
    cd "$REPO_ROOT"
    
    print_header
    
    # Get staged files
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
    
    if [ -z "$STAGED_FILES" ]; then
        print_section "No staged files"
        exit 0
    fi
    
    # Check 1: Commit message format
    print_section "Commit Message Check"
    COMMIT_MSG_FILE="$REPO_ROOT/.git/COMMIT_EDITMSG"
    
    if [ -f "$COMMIT_MSG_FILE" ]; then
        COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
        
        # Check for conventional commits format
        if ! echo "$COMMIT_MSG" | head -1 | grep -qE '^(feat|fix|docs|style|refactor|test|chore|revert)\([^)]+\): '; then
            print_warning "Commit message should follow Conventional Commits format"
            print_warning "Example: feat(crypto): Add Ed448 support"
            if [ "$STRICTNESS_LEVEL" -ge 2 ]; then
                exit 1
            fi
        fi
        
        # Check for SPDX header in commit
        if echo "$COMMIT_MSG" | grep -q "SPDX-License-Identifier"; then
            print_warning "Commit messages should not contain SPDX headers"
            if [ "$STRICTNESS_LEVEL" -ge 1 ]; then
                exit 1
            fi
        fi
        
        print_success "Commit message format check passed"
    else
        print_warning "Cannot read commit message (may be using -m flag)"
    fi
    
    # Check 2: SPDX License Headers
    if [ -n "$SPDX_CHECK_EXTENSIONS" ]; then
        print_section "SPDX License Header Check"
        
        MISSING_SPDX=0
        for ext in $SPDX_CHECK_EXTENSIONS; do
            for file in $(echo "$STAGED_FILES" | grep "\.$ext$"); do
                if [ -n "$file" ]; then
                    # Check if file has SPDX header (first 5 lines)
                    if ! head -5 "$file" | grep -q "SPDX-License-Identifier"; then
                        print_warning "Missing SPDX header in: $file"
                        MISSING_SPDX=1
                    fi
                fi
            done
        done
        
        if [ "$MISSING_SPDX" -eq 0 ]; then
            print_success "SPDX license header check passed"
        else
            if [ "$STRICTNESS_LEVEL" -ge 2 ]; then
                exit 1
            fi
        fi
    fi
    
    # Check 3: Zig formatting
    if command_exists zig; then
        ZIG_FILES=$(echo "$STAGED_FILES" | grep '\.zig$' || true)
        if [ -n "$ZIG_FILES" ]; then
            run_check "Zig Formatting" "cd $REPO_ROOT && zig fmt --check $ZIG_FILES"
        fi
    fi
    
    # Check 4: Ada compilation (basic syntax check)
    if command_exists gprbuild; then
        print_section "Ada Syntax Check"
        if echo "$STAGED_FILES" | grep -qE '\.(ads|adb)$'; then
            if ! gprbuild -P trigger.gpr --dry-run 2>/dev/null; then
                print_warning "Ada project may have compilation issues"
                if [ "$STRICTNESS_LEVEL" -ge 1 ]; then
                    exit 1
                fi
            else
                print_success "Ada syntax check passed"
            fi
        fi
    fi
    
    # Check 5: Shell script linting
    SHELL_FILES=$(echo "$STAGED_FILES" | grep -E '\.(sh|bash)$' || true)
    if [ -n "$SHELL_FILES" ]; then
        if command_exists shellcheck; then
            run_check "Shell Script Linting" "cd $REPO_ROOT && shellcheck $SHELL_FILES"
        else
            print_warning "shellcheck not installed, skipping shell linting"
        fi
    fi
    
    # Check 6: DNS zone validation
    ZONE_FILES=$(echo "$STAGED_FILES" | grep -E 'trigger\.zone$' || true)
    if [ -n "$ZONE_FILES" ]; then
        if command_exists named-checkzone; then
            run_check "DNS Zone Validation" "cd $REPO_ROOT && named-checkzone -i full trigger.example.com security/bind9/trigger.zone"
        else
            print_warning "named-checkzone not installed, skipping DNS validation"
        fi
    fi
    
    # Check 7: Documentation formatting
    DOC_FILES=$(echo "$STAGED_FILES" | grep -E '\.(adoc|md)$' || true)
    if [ -n "$DOC_FILES" ]; then
        if command_exists asciidoctor; then
            run_check "Documentation Formatting" "cd $REPO_ROOT && asciidoctor -D /tmp --safe -q $DOC_FILES"
        else
            print_warning "asciidoctor not installed, skipping documentation check"
        fi
    fi
    
    # Summary
    echo -e "\n${BLUE}========================================${NC}"
    echo -e "${BLUE}  pre-commit checks complete${NC}"
    echo -e "${BLUE}========================================${NC}\n"
}

# Run main
main "$@"
