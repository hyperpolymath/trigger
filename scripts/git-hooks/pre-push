#!/usr/bin/env bash
#
# pre-push hook for Trigger
#
# Runs comprehensive checks before allowing a push.
#
# SPDX-License-Identifier: MPL-2.0

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Source hook configuration
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"
CONFIG_FILE="$HOOK_DIR/config.sh"

# Load configuration if exists
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    # Defaults
    ENABLE_PRE_PUSH=${ENABLE_PRE_PUSH:-1}
    STRICTNESS_LEVEL=${STRICTNESS_LEVEL:-2}
    CHECK_TIMEOUT=${CHECK_TIMEOUT:-600}
fi

# Check if pre-push is enabled
if [ "$ENABLE_PRE_PUSH" -ne 1 ]; then
    echo -e "${BLUE}[pre-push]${NC} Hook disabled in config. Skipping checks."
    exit 0
fi

# Function to print header
print_header() {
    echo -e "\n${BLUE}========================================${NC}"
    echo -e "${BLUE}  Trigger pre-push Hook${NC}"
    echo -e "${BLUE}========================================${NC}\n"
}

# Function to print section
print_section() {
    echo -e "${YELLOW}--- $1 ---${NC}"
}

# Function to print success
print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Function to print failure
print_failure() {
    echo -e "${RED}✗${NC} $1"
}

# Function to print warning
print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to run a check with timeout
run_check() {
    local name="$1"
    local cmd="$2"
    local timeout="${3:-$CHECK_TIMEOUT}"
    
    print_section "$name"
    
    if ! timeout "$timeout" bash -c "$cmd" 2>&1; then
        print_failure "$name failed"
        if [ "$STRICTNESS_LEVEL" -ge 1 ]; then
            exit 1
        else
            print_warning "Continuing despite failure (strictness level: $STRICTNESS_LEVEL)"
        fi
    else
        print_success "$name passed"
    fi
}

# Main execution
main() {
    cd "$REPO_ROOT"
    
    print_header
    
    # Check 1: Build test
    if command_exists just; then
        run_check "Build Test" "cd $REPO_ROOT && just build" 300
    else
        print_warning "just not installed, skipping build test"
    fi
    
    # Check 2: Test suite
    if command_exists just; then
        run_check "Test Suite" "cd $REPO_ROOT && just test" 300
    else
        print_warning "just not installed, skipping test suite"
    fi
    
    # Check 3: Format check
    if command_exists just; then
        run_check "Format Check" "cd $REPO_ROOT && just format-check" 60
    else
        print_warning "just not installed, skipping format check"
    fi
    
    # Check 4: Lint check
    if command_exists just; then
        run_check "Lint Check" "cd $REPO_ROOT && just lint" 120
    else
        print_warning "just not installed, skipping lint check"
    fi
    
    # Check 5: pons (static analysis)
    if command_exists pons; then
        run_check "pons Static Analysis" "cd $REPO_ROOT && pons" 300
    else
        print_warning "pons not installed, skipping static analysis"
    fi
    
    # Check 6: panic-attack (dangerous pattern detection)
    if command_exists panic-attack; then
        run_check "panic-attack Scan" "cd $REPO_ROOT && panic-attack assail" 300
    else
        print_warning "panic-attack not installed, skipping dangerous pattern scan"
    fi
    
    # Check 7: Container build
    if command_exists podman; then
        run_check "Container Build" "cd $REPO_ROOT && podman build -f CONTAINERFILE --no-cache -t hyperpolymath/trigger:test ." 600
    else
        print_warning "podman not installed, skipping container build"
    fi
    
    # Check 8: DNS validation
    if command_exists named-checkzone; then
        ZONE_FILES=$(find "$REPO_ROOT/security/bind9" -name "*.zone" 2>/dev/null || true)
        if [ -n "$ZONE_FILES" ]; then
            for zone_file in $ZONE_FILES; do
                zone_name=$(basename "$zone_file" .zone)
                run_check "DNS Zone Validation ($zone_name)" "cd $REPO_ROOT && named-checkzone -i full $zone_name $zone_file"
            done
        fi
    fi
    
    # Check 9: Check for secrets
    print_section "Secret Detection"
    SECRET_PATTERNS=(
        "password\s*[=:]" 
        "secret\s*[=:]" 
        "api[_-]?key\s*[=:]" 
        "token\s*[=:]" 
        "private[_-]?key" 
        "[0-9]{40,}" 
    )
    
    SECRETS_FOUND=0
    for pattern in "${SECRET_PATTERNS[@]}"; do
        if git grep -i -l "$pattern" 2>/dev/null | grep -v "\.git/" | grep -v "^test" | grep -v "\.enc$"; then
            print_warning "Potential secret detected matching: $pattern"
            SECRETS_FOUND=1
        fi
    done
    
    if [ "$SECRETS_FOUND" -eq 0 ]; then
        print_success "Secret detection passed"
    else
        print_failure "Potential secrets detected"
        if [ "$STRICTNESS_LEVEL" -ge 1 ]; then
            exit 1
        fi
    fi
    
    # Check 10: Large file detection
    print_section "Large File Check"
    LARGE_FILES=$(find "$REPO_ROOT" -type f -size +50M -not -path "$REPO_ROOT/.git/*" 2>/dev/null || true)
    if [ -n "$LARGE_FILES" ]; then
        print_warning "Large files detected (may not push to GitHub):"
        for file in $LARGE_FILES; do
            size=$(du -h "$file" | cut -f1)
            print_warning "  $file ($size)"
        done
        if [ "$STRICTNESS_LEVEL" -ge 2 ]; then
            exit 1
        fi
    else
        print_success "Large file check passed"
    fi
    
    # Summary
    echo -e "\n${BLUE}========================================${NC}"
    echo -e "${BLUE}  pre-push checks complete${NC}"
    echo -e "${BLUE}========================================${NC}\n"
}

# Run main
main "$@"
