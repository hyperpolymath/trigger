# SELinux Configuration for Trigger Application
#
# This configuration defines SELinux policies and contexts for the Trigger
# application running in a container environment.
#
# SPDX-License-Identifier: CC-BY-SA-4.0

# SELinux Mode
# Options: disabled, permissive, enforcing
SELINUX=enforcing

# SELINUXTYPE can take one of these three values:
#     targeted - Only targeted network daemons are protected
#     minimum  - Modification of targeted. Only selected processes are protected
#     mls      - Multi Level Security protection
SELINUXTYPE=targeted

# Container-specific settings
CONTAINER_SELINUX=enforcing
CONTAINER_SELINUX_TYPE=container_runtime_t

# Port type definitions
PORT_TYPE_80=tcp http_port_t
PORT_TYPE_443=tcp http_port_t
PORT_TYPE_8080=tcp http_cache_port_t
PORT_TYPE_8443=tcp http_port_t
PORT_TYPE_22=tcp ssh_port_t
PORT_TYPE_53_udp=udp dns_port_t
PORT_TYPE_53_tcp=tcp dns_port_t

# File context mappings
FILE_CONTEXT sujeto /app(/.*): container_file_t
FILE_CONTEXT objeto /app/bin(/.*): container_exec_t
FILE_CONTEXT objeto /app/lib(/.*): container_var_lib_t
FILE_CONTEXT objeto /app/config(/.*): container_config_t
FILE_CONTEXT objeto /app/sessions(/.*): container_session_t
FILE_CONTEXT objeto /app/logs(/.*): container_log_t
FILE_CONTEXT objeto /app/cache(/.*): container_cache_t

# Boolean settings
SELINUX_BOOL container_connect_any=1
SELINUX_BOOL container_manage_cgroup=1
SELINUX_BOOL httpd_can_network_connect=1
SELINUX_BOOL httpd_can_network_relay=0
SELINUX_BOOL nfs_export_all_rw=0
SELINUX_BOOL allow_ftpd_full_access=0
SELINUX_BOOL allow_httpd_mod_auth_pam=0
SELINUX_BOOL httpd_enable_cgi=0
SELINUX_BOOL httpd_enable_homedirs=0

# Deny rules
DENY Type=container_t,Access=create,Class=file,Perm=all
DENY Type=container_t,Access=unlink,Class=file,Perm=all
DENY Type=container_t,Access=write,Class=file,Perm=all,Context=container_config_t
DENY Type=container_t,Access=write,Class=file,Perm=all,Context=container_session_t

# Allow rules
ALLOW Type=container_t,Access=execute,Class=file,Perm=execute,Context=container_exec_t
ALLOW Type=container_t,Access=read,Class=file,Perm=read,Context=container_file_t
ALLOW Type=container_t,Access=write,Class=file,Perm=write,Context=container_log_t
ALLOW Type=container_t,Access=write,Class=file,Perm=write,Context=container_cache_t
ALLOW Type=container_t,Access=create,Class=file,Perm=create,Context=container_cache_t
