#  Trigger - Git Ignore File
#  
#  Specifies files and directories to be ignored by git

#  Build artifacts
obj/
bin/
*.o
*.ali
*.a

#  Executables
trigger

#  Session data (contains sensitive information)
sessions/
*.session
*.sessionj

#  Configuration files (local to user)
config.json
config.json.bak

#  Log files
*.log
logs/

#  Temporary files
*.tmp
*.swp
*~
.TMP

#  IDE/Editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

#  OS-specific files
.DS_Store
Thumbs.db

#  Environment files
.env
.env.local
.env.*.local

#  Ada/SPARK specific
.alire/
.alr/
gnat.cgpr

#  Zig specific
.zig-cache/

#  Idris2 specific
.idris2/

#  Test and coverage
.coverage
*.lcov
*.lcov.info
coverage/

#  Documentation build
docs/_build/
docs/_static/

#  FFI shared libraries
*.so
*.dll
*.dylib
